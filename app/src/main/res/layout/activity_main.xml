<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="696dp"
        android:layout_height="833dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:background="@color/lytPrimary"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.504">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="180dp"
            android:layout_height="200dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/baseline_account_circle_24" />

        <EditText
            android:id="@+id/txtUsuario"
            android:layout_width="323dp"
            android:layout_height="48dp"
            android:layout_margin="10dp"
            android:drawableStart="@drawable/ic_launcher_person_fill"
            android:ems="10"
            android:hint="Ingrese tu usuario"
            android:inputType="text"
            android:textColor="#000000"
            android:textColorHint="#7C7979" />

        <EditText
            android:id="@+id/txtContrasena"
            android:layout_width="316dp"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_launcher_key_fill"
            android:ems="10"
            android:hint="Ingresa tu contraseña"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#7C7979" />

        <Button
            android:id="@+id/btnCrear"
            android:layout_width="323dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:backgroundTint="@color/btnPrimary"
            android:onClick="login"
            android:text="Login"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/txtCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="auto"
            android:onClick="create"
            android:text="No tienes cuenta? Crear cuenta"
            android:textAlignment="center"
            android:textColor="#8C0606"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>